rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Sessions are addressed by a random 6-character pairing code. No listing is allowed,
    // so a guardian must know the code. Raw audio is never stored; only signals + short quotes.
    match /sessions/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && code.size() == 6;
      allow update: if request.auth != null && (
        resource.data.owner == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['holdStatus'])
      );
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;

      match /alerts/{alertId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && get(/databases/$(database)/documents/sessions/$(code)).data.owner == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
